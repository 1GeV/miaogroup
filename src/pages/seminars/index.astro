---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const records = (await getCollection('seminars', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const semesters = [...new Set(records.map((record) => record.data.semester))];
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Shanghai' }).format(date);
---
<Layout title="Seminars">
  <section class="page-intro"><p class="eyebrow">A shared blackboard</p><h1>Strings, Fields<br /><em>and Holography</em> Seminar</h1><p>Talks and reading conversations across modern high-energy theory.</p></section>
  {semesters.length ? semesters.map((semester) => <section class="semester-section"><div class="section-heading"><div><p class="eyebrow">{records.find((record) => record.data.semester === semester)?.data.current ? 'Current semester' : 'Archive'}</p><h2>{semester}</h2></div></div><div class="seminar-list">{records.filter((record) => record.data.semester === semester).map((record) => <article class="seminar-card"><div class="seminar-card-date">{formatDate(record.data.date)}</div><div><p class="event-type">{record.data.speaker}</p><h3>{record.data.title}</h3>{record.data.paper && <p class="muted">Reading: {record.data.paper}</p>}{record.data.onlineMeeting && <p class="muted">{record.data.onlineMeeting}</p>}<div class="card-links">{record.data.references.map((reference) => <a href={reference.url} target="_blank" rel="noreferrer">{reference.label} ↗</a>)}{record.data.recordingUrl && <a href={record.data.recordingUrl} target="_blank" rel="noreferrer">Recording ↗</a>}</div></div></article>)}</div></section>) : <div class="archive-empty"><span class="empty-index">01</span><h2>No talks scheduled.</h2></div>}
</Layout>
