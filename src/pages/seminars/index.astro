---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { normalizeOnlineMeetings, renderContact, renderMath, renderMeetingCopy } from '../../lib/content';

const records = (await getCollection('seminars', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const termSettings = await getCollection('seminarTerms');
const seriesSettings = await getCollection('seminarSeries', ({ data }) => !data.draft);
const seriesKey = (value: string) => value.replace(/\$[^$\n]*\$/g, '').replace(/\s+/g, ' ').trim();
const matchingSeries = (value: string, candidate: string) => value === candidate || seriesKey(value) === seriesKey(candidate);

const seriesNames = [...new Set(records.map((record) => record.data.series))];
const seriesGroups = seriesNames.map((series) => {
  const seriesRecords = records.filter((record) => record.data.series === series);
  const semesters = [...new Set(seriesRecords.map((record) => record.data.semester))];
  const settings = seriesSettings.find((setting) => matchingSeries(setting.data.series, series))?.data;
  const termSetting = (semester: string) => termSettings.find((term) => term.data.semester === semester && matchingSeries(term.data.series, series));
  const displaySeries = termSettings.find((term) => matchingSeries(term.data.series, series))?.data.series ?? settings?.series ?? series;
  return {
    series: displaySeries,
    description: settings?.description,
    contact: settings?.contact,
    links: settings?.links ?? [],
    terms: semesters.map((semester) => {
      const termRecords = seriesRecords.filter((record) => record.data.semester === semester);
      const configuredArchiveDate = termSetting(semester)?.data.archiveAfter;
      const archiveAfter = configuredArchiveDate ?? new Date(Math.max(...termRecords.map((record) => record.data.date.valueOf())));
      const firstTalkDate = new Date(Math.min(...termRecords.map((record) => record.data.date.valueOf())));
      const now = new Date();
      const status = archiveAfter < now ? 'Archive' : firstTalkDate > now ? 'Upcoming term' : 'Current term';
      return { semester, records: termRecords, archiveAfter, firstTalkDate, status };
    })
  };
});

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'Asia/Shanghai'
}).format(date);
const seriesAnchor = (series: string) => `series-${series.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<Layout title="Seminars">
  <section class="page-intro">
    <p class="eyebrow">A shared blackboard</p>
    <h1>Seminar series</h1>
    <p>Talks and reading conversations across modern high-energy theory.</p>
  </section>

  {seriesGroups.length ? seriesGroups.map(({ series, description, contact, links, terms }) => (
    <section class="semester-section" id={seriesAnchor(series)}>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Seminar</p>
          <h2 set:html={renderMath(series)}></h2>
        </div>
      </div>
      {(description || contact || links.length) && <div class="series-overview">
        {description && <p set:html={renderMath(description)}></p>}
        {contact && <p class="series-contact" set:html={renderContact(contact)}></p>}
        {links.length > 0 && <div class="card-links series-links">
          {links.map((link) => link.url ? <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a> : <span class="reference-label">{link.label}</span>)}
        </div>}
      </div>}
      {terms.map(({ semester, records: termRecords, archiveAfter, firstTalkDate, status }) => (
        <div class="seminar-term">
          <div class="section-heading">
            <div>
              <p class="eyebrow term-status" data-archive-after={archiveAfter.toISOString()} data-first-talk={firstTalkDate.toISOString()}>{status}</p>
              <h3 set:html={renderMath(semester)}></h3>
            </div>
          </div>
          <div class="seminar-list">
            {termRecords.map((record) => (
              <article class="seminar-card" id={`talk-${record.id}`}>
                <div class="seminar-card-date">{formatDate(record.data.date)}</div>
                <div>
                  <p class="event-type" set:html={renderMath(record.data.speaker)}></p>
                  <h3 set:html={renderMath(record.data.title)}></h3>
                  {record.data.time && <p class="muted">Time: {record.data.time}</p>}
                  {record.data.location && <p class="muted">Location: {record.data.location}</p>}
                  {record.data.description && <p class="muted" set:html={renderMath(record.data.description)}></p>}
                  {record.data.paper && <p class="muted" set:html={renderMath(`Reading: ${record.data.paper}`)}></p>}
                  {normalizeOnlineMeetings(record.data.onlineMeeting).length > 0 && <p class="muted meeting-line">{normalizeOnlineMeetings(record.data.onlineMeeting).map((meeting, index) => <>{index > 0 && ' · '}{meeting.url ? <a class="meeting-link" href={meeting.url} target="_blank" rel="noreferrer">{meeting.label} ↗</a> : meeting.copy === meeting.label ? <span set:html={renderMeetingCopy(meeting.copy || meeting.label)} /> : <span class="meeting-label">{meeting.label}</span>}{meeting.copy && meeting.copy !== meeting.label && <> · <span set:html={renderMeetingCopy(meeting.copy)} /></>}</>)}</p>}
                  <div class="card-links">
                    {record.data.references.map((reference) => reference.url ? <a href={reference.url} target="_blank" rel="noreferrer" set:html={`${renderMath(reference.label)} ↗`}></a> : <span class="reference-label" set:html={renderMath(reference.label)}></span>)}
                    {record.data.recordingUrl && <a href={record.data.recordingUrl} target="_blank" rel="noreferrer">Recording ↗</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>
  )) : <div class="archive-empty"><span class="empty-index">01</span><h2>No talks scheduled.</h2></div>}
  <script>
    document.querySelectorAll('.term-status[data-archive-after]').forEach((status) => {
      const archiveAfter = status.getAttribute('data-archive-after');
      const firstTalkDate = status.getAttribute('data-first-talk');
      if (archiveAfter && firstTalkDate) {
        const now = new Date();
        status.textContent = new Date(archiveAfter) < now ? 'Archive' : new Date(firstTalkDate) > now ? 'Upcoming term' : 'Current term';
      }
    });
    const revealTalkFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const target = document.getElementById(id);
      if (!target?.classList.contains('seminar-card')) return;
      requestAnimationFrame(() => {
        target.scrollIntoView({ block: 'center', behavior: 'smooth' });
        target.classList.add('seminar-card-highlight');
        window.setTimeout(() => target.classList.remove('seminar-card-highlight'), 1600);
      });
    };
    revealTalkFromHash();
    window.addEventListener('hashchange', revealTalkFromHash);
  </script>
</Layout>
