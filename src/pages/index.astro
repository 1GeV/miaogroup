---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const upcoming = events.filter((event) => event.data.date >= new Date()).slice(0, 3);
const seminars = (await getCollection('seminars', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentSeminar = seminars.find((seminar) => seminar.data.current) ?? seminars[0];
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Shanghai' }).format(date);
const typeLabel = (type: string) => type.replace('-', ' ');
---
<Layout title="Home">
  <section class="hero section-grid">
    <div class="hero-copy">
      <p class="eyebrow">Theoretical physics · Sun Yat-sen University</p>
      <h1>Miao Group</h1>
      <p class="hero-lede">A working space for conversations around strings, fields, holography, and the geometry of quantum theory.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}seminars/`}>Explore the seminar <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}calendar/`}>View academic calendar <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-diagram" aria-hidden="true">
      <div class="diagram-field">
        <div class="diagram-boundary-line"></div>
        <div class="boundary-label">boundary</div>
        <div class="boundary-operators">
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="bulk-network">
          <span class="network-line line-a"></span>
          <span class="network-line line-b"></span>
          <span class="network-line line-c"></span>
          <span class="network-line line-d"></span>
          <span class="network-line line-e"></span>
          <span class="network-line line-f"></span>
          <span class="network-node node-a"></span>
          <span class="network-node node-b"></span>
          <span class="network-node node-c"></span>
          <span class="network-node node-d"></span>
          <span class="network-core">bulk</span>
        </div>
      </div>
      <span class="formula formula-correspondence"><i>Z</i><sub>CFT</sub> = <i>Z</i><sub>AdS</sub></span>
      <span class="diagram-caption">boundary &harr; bulk</span>
    </div>
  </section>

  <section class="section-block" aria-labelledby="upcoming-title">
    <div class="section-heading"><div><p class="eyebrow">The next horizon</p><h2 id="upcoming-title">Upcoming academic activity</h2></div><a class="text-link" href={`${base}calendar/`}>Full calendar <span aria-hidden="true">→</span></a></div>
    {upcoming.length ? <div class="event-list">{upcoming.map((event) => <article class="event-row"><time datetime={event.data.date.toISOString()}><strong>{event.data.date.getDate().toString().padStart(2, '0')}</strong><span>{formatDate(event.data.date).split(' ')[0]}</span></time><div><p class="event-type">{typeLabel(event.data.type)}</p><h3>{event.data.title}</h3><p class="muted">{[event.data.speaker, event.data.time, event.data.location, event.data.onlineMeeting].filter(Boolean).join(' · ')}</p></div><span class="arrow" aria-hidden="true">↗</span></article>)}</div> : <div class="empty-state"><span class="empty-index">01</span><div><h3>The calendar is ready for its first entry.</h3><p>Add one Markdown file to <code>src/content/events/</code> to publish a group meeting, lecture, seminar, defense, or other academic activity.</p></div><a class="text-link" href="https://github.com/1GeV/miaogroup">Edit on GitHub <span aria-hidden="true">↗</span></a></div>}
  </section>

  <section class="seminar-banner section-grid">
    <div><p class="eyebrow">A recurring conversation</p><h2>Strings, Fields<br /><em>and Holography</em><br />Seminar</h2></div>
    <div class="seminar-summary">{currentSeminar ? <><p class="event-type">Current semester · {currentSeminar.data.semester}</p><h3>{currentSeminar.data.title}</h3><p class="muted">{currentSeminar.data.speaker} · {formatDate(currentSeminar.data.date)}</p></> : <><p class="event-type">Current semester</p><h3>The seminar archive is ready.</h3><p class="muted">The first talk can be added as a single Markdown file.</p></>}<a class="button button-light" href={`${base}seminars/`}>Enter the archive <span aria-hidden="true">↗</span></a></div>
  </section>
</Layout>
