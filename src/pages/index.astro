---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { normalizeOnlineMeetings, renderMath, renderMeetingCopy } from '../lib/content';
const base = import.meta.env.BASE_URL;
const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const seminars = (await getCollection('seminars', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const scheduleFor = (entry: { data: { date: Date; time?: string; endDate?: Date } }) => {
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(entry.data.date).reduce((result, part) => ({ ...result, [part.type]: part.value }), {} as Record<string, string>);
  const times = entry.data.time?.match(/(\d{1,2}):(\d{2})(?:\s*[-–—]\s*(\d{1,2}):(\d{2}))?/);
  const makeTime = (hour: string, minute: string) => new Date(`${parts.year}-${parts.month}-${parts.day}T${hour.padStart(2, '0')}:${minute}:00+08:00`);
  const start = times ? makeTime(times[1], times[2]) : new Date(entry.data.date);
  const end = times?.[4] ? makeTime(times[3], times[4]) : undefined;
  return { start, end };
};
const now = new Date();
const nextPublicEvent = events
  .filter((event) => event.data.public)
  .map((entry) => ({ entry, schedule: scheduleFor(entry) }))
  .filter(({ schedule }) => schedule.start >= now || Boolean(schedule.end && schedule.end > now))
  .sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf())[0];
const nextSeminar = seminars
  .map((entry) => ({ entry, schedule: scheduleFor(entry) }))
  .filter(({ schedule }) => schedule.start >= now || Boolean(schedule.end && schedule.end > now))
  .sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf())[0];
const upcoming = [
  ...(nextPublicEvent ? [{ kind: 'event' as const, entry: nextPublicEvent.entry, schedule: nextPublicEvent.schedule }] : []),
  ...(nextSeminar ? [{ kind: 'seminar' as const, entry: nextSeminar.entry, schedule: nextSeminar.schedule }] : [])
].sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf());
const currentSeminar = seminars
  .filter((seminar) => seminar.data.date >= new Date())
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())[0] ?? seminars[0];
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Shanghai' }).format(date);
const typeLabel = (type: string) => type.replace('-', ' ');
---
<Layout title="Home">
  <section class="hero section-grid">
    <div class="hero-copy">
      <p class="eyebrow">Theoretical physics · Sun Yat-sen University</p>
      <h1>Miao Group</h1>
      <p class="hero-lede">Research in holography, strings, and quantum gravity.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}seminars/`}>Explore the seminar <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}calendar/`}>View academic calendar <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-diagram" aria-hidden="true">
      <svg class="diagram-svg" viewBox="0 0 520 300" role="presentation">
        <line class="svg-boundary" x1="42" y1="42" x2="478" y2="42" />
        <text class="svg-label" x="42" y="24">boundary</text>
        <g class="svg-network">
          <path d="M75 42 Q132 130 238 220" />
          <path d="M150 42 Q210 112 252 220" />
          <path d="M370 42 Q310 112 268 220" />
          <path d="M445 42 Q388 130 282 220" />
          <circle cx="144.25" cy="130.5" r="5" /><circle cx="205.5" cy="121.5" r="5" />
          <circle cx="314.5" cy="121.5" r="5" /><circle cx="375.75" cy="130.5" r="5" />
        </g>
        <g class="svg-operators">
          <circle cx="75" cy="42" r="5" /><circle cx="150" cy="42" r="5" /><circle cx="225" cy="42" r="5" />
          <circle cx="295" cy="42" r="5" /><circle cx="370" cy="42" r="5" /><circle cx="445" cy="42" r="5" />
        </g>
        <circle class="svg-bulk" cx="260" cy="245" r="28" /><text class="svg-bulk-label" x="260" y="249">bulk</text>
      </svg>
      <span class="formula formula-correspondence"><i>Z</i><sub>CFT</sub> = <i>Z</i><sub>AdS</sub></span>
    </div>
  </section>

  {upcoming.length > 0 && <section class="section-block" aria-labelledby="upcoming-title">
    <div class="section-heading"><div><p class="eyebrow">The next horizon</p><div class="upcoming-heading"><h2 id="upcoming-title">Upcoming academic activity</h2>{upcoming[0] && <span class="upcoming-countdown" data-start={upcoming[0].schedule.start.toISOString()} data-end={upcoming[0].schedule.end?.toISOString() || ''}>Loading…</span>}</div></div><a class="text-link" href={`${base}calendar/`}>Full calendar <span aria-hidden="true">→</span></a></div>
    <div class="event-list">{upcoming.map(({ kind, entry }) => {
      const { data } = entry;
      const href = kind === 'seminar'
        ? `${base}seminars/#talk-${entry.id}`
        : `${base}calendar/?event=${encodeURIComponent(entry.id)}`;
      const meetings = normalizeOnlineMeetings(data.onlineMeeting);
      const details = [data.speaker, data.time, kind === 'event' && data.location].filter(Boolean) as string[];
      return <a class="event-row event-row-link" href={href} aria-label={`View ${data.title}`}><time datetime={data.date.toISOString()}><strong>{data.date.getDate().toString().padStart(2, '0')}</strong><span>{formatDate(data.date).split(' ')[0]}</span></time><div><p class="event-type">{typeLabel(kind === 'seminar' ? 'seminar' : data.type)}</p><h3 set:html={renderMath(data.title)}></h3><p class="muted">{details.map((detail, index) => <>{index > 0 && ' · '}{detail}</>)}{meetings.length > 0 && <>{details.length > 0 && ' · '}{meetings.map((meeting, index) => <>{index > 0 && ' · '}<span class="meeting-link">{meeting.label}</span>{meeting.copy && ' · '}{meeting.copy && <span set:html={renderMeetingCopy(meeting.copy)} />}</>)}</>}</p></div><span class="event-row-arrow" aria-hidden="true">→</span></a>;
    })}</div>
  </section>}

  <section class="seminar-banner section-grid">
    <div><p class="eyebrow">A recurring conversation</p><h2>Strings, Fields<br /><em>and Holography</em><br />Seminar</h2></div>
    <div class="seminar-summary">{currentSeminar ? <><p class="event-type">Next seminar · {currentSeminar.data.semester}</p><h3 set:html={renderMath(currentSeminar.data.title)}></h3><p class="muted">{[currentSeminar.data.speaker, formatDate(currentSeminar.data.date), currentSeminar.data.time].filter(Boolean).join(' · ')}</p></> : <><p class="event-type">Seminar series</p><h3>Talks to be announced.</h3></>}<a class="button button-light" href={`${base}seminars/`}>Enter the archive <span aria-hidden="true">↗</span></a></div>
  </section>
  <script>
    const countdown = document.querySelector('.upcoming-countdown');
    const updateCountdown = () => {
      if (!countdown) return;
      const start = new Date(countdown.dataset.start);
      const end = countdown.dataset.end ? new Date(countdown.dataset.end) : null;
      const remaining = start.getTime() - Date.now();
      if (remaining <= 0 && end && Date.now() < end.getTime()) { countdown.textContent = 'In progress'; return; }
      if (remaining <= 0) { countdown.textContent = remaining > -60000 ? 'Starting now' : 'Started'; return; }
      const minutes = Math.floor(remaining / 60000);
      const hours = Math.floor(minutes / 60);
      const days = Math.floor(hours / 24);
      if (days > 5) countdown.textContent = `in ${days} days`;
      else if (days >= 1) countdown.textContent = `in ${days} day${days === 1 ? '' : 's'} ${hours % 24} hour${hours % 24 === 1 ? '' : 's'}`;
      else if (hours >= 1) countdown.textContent = `in ${hours} hour${hours === 1 ? '' : 's'}`;
      else if (minutes >= 1) countdown.textContent = `in ${minutes} minute${minutes === 1 ? '' : 's'}`;
      else countdown.textContent = 'Starting now';
    };
    updateCountdown();
    window.setInterval(updateCountdown, 30000);
  </script>
</Layout>
