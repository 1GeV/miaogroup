---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { normalizeOnlineMeetings, renderContact, renderMath, renderMeetingCopy, renderSpeaker } from '../lib/content';
import { isCurrentOrUpcoming, scheduleFor } from '../lib/schedule';
const base = import.meta.env.BASE_URL;
// String.raw keeps LaTeX commands literal; write formulas here with one backslash, such as $\mathcal{H}$.
const homepageSeriesName = String.raw`Strings, Fields and Holography Seminar`;
const seriesKey = (value: string) => value.replace(/\$[^$\n]*\$/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
// Derive the banner's line breaks and emphasis from the same name used for series matching.
const homepageSeriesHeading = (() => {
  const match = homepageSeriesName.match(/^(.*?)\s+(and\s+.*?)\s+(Seminar)$/i);
  return match ? { lead: match[1], accent: match[2], suffix: match[3] } : null;
})();
const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const seminars = (await getCollection('seminars', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const now = new Date();
const publicUpcomingEvents = events
  .filter((event) => event.data.public)
  .map((entry) => ({ entry, schedule: scheduleFor(entry.data) }))
  .filter(({ schedule }) => isCurrentOrUpcoming(schedule, now))
  .sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf());
const upcomingSeminars = seminars
  .map((entry) => ({ entry, schedule: scheduleFor(entry.data) }))
  .filter(({ schedule }) => isCurrentOrUpcoming(schedule, now))
  .sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf());
const allUpcoming = [
  ...publicUpcomingEvents.map(({ entry, schedule }) => ({ kind: 'event' as const, entry, schedule })),
  ...upcomingSeminars.map(({ entry, schedule }) => ({ kind: 'seminar' as const, entry, schedule }))
].sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf());
const upcoming = [
  ...(publicUpcomingEvents[0] ? [{ kind: 'event' as const, ...publicUpcomingEvents[0] }] : []),
  ...(upcomingSeminars[0] ? [{ kind: 'seminar' as const, ...upcomingSeminars[0] }] : [])
].sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf());
// The banner is dedicated to the series named in its heading; other series stay on the archive and calendar.
const seminarSchedules = seminars
  .filter(({ data }) => seriesKey(data.series) === seriesKey(homepageSeriesName))
  .map((entry) => ({ entry, schedule: scheduleFor(entry.data) }))
  .sort((a, b) => a.schedule.start.valueOf() - b.schedule.start.valueOf());
const currentSeminar = seminarSchedules.find(({ schedule }) => schedule.start <= now && Boolean(schedule.end && schedule.end > now));
const nextSeminar = seminarSchedules.find(({ schedule }) => schedule.start > now);
const latestSeminar = [...seminarSchedules].reverse().find(({ schedule }) => schedule.start <= now);
const featuredSeminar = currentSeminar ?? nextSeminar ?? latestSeminar;
const featuredSeminarLabel = currentSeminar ? 'Current seminar' : nextSeminar ? 'Next seminar' : latestSeminar ? 'Latest seminar' : 'Seminar series';
const featuredSeminarHref = featuredSeminar ? `${base}seminars/#talk-${featuredSeminar.entry.id}` : `${base}seminars/`;
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Shanghai' }).format(date);
const formatDay = (date: Date) => new Intl.DateTimeFormat('en-US', { day: '2-digit', timeZone: 'Asia/Shanghai' }).format(date);
const typeLabel = (type: string) => type.replace('-', ' ');
---
<Layout title="Home" description="Miao Group at Sun Yat-sen University: public academic activities and seminars in holography, string theory, and quantum gravity.">
  <section class="hero section-grid">
    <div class="hero-copy">
      <p class="eyebrow">Theoretical physics · Sun Yat-sen University</p>
      <h1>Miao Group</h1>
      <p class="hero-lede">Research in holography, strings, and quantum gravity.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}seminars/`}>Explore seminars <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}calendar/`}>View academic calendar <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-diagram" aria-hidden="true">
      <svg class="diagram-svg" viewBox="0 0 520 300" role="presentation">
        <line class="svg-boundary" x1="42" y1="42" x2="478" y2="42" />
        <text class="svg-label" x="42" y="24">boundary</text>
        <g class="svg-network">
          <path d="M90 42 C108 76 136 113 164 141 C192 169 226 209 260 245" />
          <path d="M200 42 C216 79 231 116 241 150 C249 178 255 213 260 245" />
          <path d="M320 42 C304 79 289 116 279 150 C271 178 265 213 260 245" />
          <path d="M430 42 C412 76 384 113 356 141 C328 169 294 209 260 245" />
          <circle cx="164" cy="141" r="5" /><circle cx="241" cy="150" r="5" />
          <circle cx="279" cy="150" r="5" /><circle cx="356" cy="141" r="5" />
        </g>
        <g class="svg-operators">
          <circle cx="90" cy="42" r="5" /><circle cx="200" cy="42" r="5" />
          <circle cx="320" cy="42" r="5" /><circle cx="430" cy="42" r="5" />
        </g>
        <circle class="svg-bulk" cx="260" cy="245" r="29" /><text class="svg-bulk-label" x="260" y="249">bulk</text>
      </svg>
      <span class="formula formula-correspondence"><i>Z</i><sub>CFT</sub> = <i>Z</i><sub>AdS</sub></span>
    </div>
  </section>

  {allUpcoming.length > 0 && <section class="section-block" aria-labelledby="upcoming-title">
    <div class="section-heading"><div><p class="eyebrow">The next horizon</p><div class="upcoming-heading"><h2 id="upcoming-title">Upcoming academic activity</h2>{upcoming[0] && <span class="upcoming-countdown" data-start={upcoming[0].schedule.start.toISOString()} data-end={upcoming[0].schedule.end?.toISOString() || ''}>Loading…</span>}</div></div><a class="text-link" href={`${base}calendar/`}>Full calendar <span aria-hidden="true">→</span></a></div>
    <div class="event-list">{allUpcoming.map(({ kind, entry, schedule }) => {
      const { data } = entry;
      const href = kind === 'seminar'
        ? `${base}seminars/#talk-${entry.id}`
        : `${base}calendar/?event=${encodeURIComponent(entry.id)}`;
      const meetings = normalizeOnlineMeetings(data.onlineMeeting);
      const visible = upcoming.some((item) => item.kind === kind && item.entry.id === entry.id);
      return <article class="event-row event-row-link" data-kind={kind} data-start={schedule.start.toISOString()} data-end={schedule.end?.toISOString() || ''} data-href={href} tabindex="0" role="link" aria-label={`View ${data.title}`} hidden={!visible}><time datetime={data.date.toISOString()}><strong>{formatDay(data.date)}</strong><span>{formatDate(data.date).split(' ')[0]}</span></time><div><p class="event-type">{typeLabel(kind === 'seminar' ? 'seminar' : data.type)}</p><h3 set:html={renderMath(data.title)}></h3><p class="muted">{data.speaker && <span set:html={renderSpeaker(data.speaker)} />}{data.speaker && (data.time || data.location || data.contact || meetings.length > 0) && ' · '}{data.time}{data.time && (data.location || data.contact || meetings.length > 0) && ' · '}{data.location}{data.location && (data.contact || meetings.length > 0) && ' · '}{data.contact && <span set:html={renderContact(data.contact)} />}{data.contact && meetings.length > 0 && ' · '}{meetings.map((meeting, index) => <>{index > 0 && ' · '}{meeting.url ? <a class="meeting-link" href={meeting.url} target="_blank" rel="noreferrer">{meeting.label} ↗</a> : <span class="meeting-link">{meeting.label}</span>}{meeting.copy && ' · '}{meeting.copy && <span set:html={renderMeetingCopy(meeting.copy)} />}</>)}</p></div><span class="event-row-arrow" aria-hidden="true">→</span></article>;
    })}</div>
  </section>}

  <section class="seminar-banner section-grid">
    <div><p class="eyebrow">A recurring conversation</p><h2>{homepageSeriesHeading ? <><span set:html={renderMath(homepageSeriesHeading.lead)}></span><br /><em set:html={renderMath(homepageSeriesHeading.accent)}></em><br /><span set:html={renderMath(homepageSeriesHeading.suffix)}></span></> : <span set:html={renderMath(homepageSeriesName)}></span>}</h2></div>
    <div class="seminar-summary">{featuredSeminar ? <><p class="event-type">{featuredSeminarLabel}</p><h3 set:html={renderMath(featuredSeminar.entry.data.title)}></h3><p class="muted"><span set:html={renderSpeaker(featuredSeminar.entry.data.speaker)} /> · {formatDate(featuredSeminar.entry.data.date)}{featuredSeminar.entry.data.time && <> · {featuredSeminar.entry.data.time}</>}</p></> : <><p class="event-type">Seminar series</p><h3>Talks to be announced.</h3></>}<a class="button button-light" href={featuredSeminarHref}>{featuredSeminar ? 'View seminar' : 'Explore seminars'} <span aria-hidden="true">↗</span></a></div>
  </section>
  <script>
    document.querySelectorAll('.event-row-link[data-href]').forEach((row) => {
      const go = () => { window.location.href = row.dataset.href; };
      row.addEventListener('click', (event) => { if (!event.target.closest('a,[data-copy]')) go(); });
      row.addEventListener('keydown', (event) => { if (['Enter', ' '].includes(event.key)) { event.preventDefault(); go(); } });
    });
    const upcomingSection = document.querySelector('[aria-labelledby="upcoming-title"]');
    const refreshUpcoming = () => {
      const candidates = [...document.querySelectorAll('.event-row-link[data-start]')];
      const nextByKind = new Map();
      candidates.forEach((row) => {
        const expires = row.dataset.end ? new Date(row.dataset.end).getTime() : new Date(row.dataset.start).getTime();
        if (Date.now() < expires && !nextByKind.has(row.dataset.kind)) nextByKind.set(row.dataset.kind, row);
      });
      candidates.forEach((row) => { row.hidden = nextByKind.get(row.dataset.kind) !== row; });
      const visibleRows = candidates.filter((row) => !row.hidden);
      if (upcomingSection && !visibleRows.length) upcomingSection.remove();
      return visibleRows.sort((a, b) => new Date(a.dataset.start).getTime() - new Date(b.dataset.start).getTime());
    };
    const updateCountdown = () => {
      const visibleRows = refreshUpcoming();
      const countdown = document.querySelector('.upcoming-countdown');
      if (!countdown) return;
      if (!visibleRows.length) return;
      const firstRow = visibleRows[0];
      if (firstRow) {
        countdown.dataset.start = firstRow.dataset.start || '';
        countdown.dataset.end = firstRow.dataset.end || '';
      }
      const start = new Date(countdown.dataset.start);
      const end = countdown.dataset.end ? new Date(countdown.dataset.end) : null;
      const remaining = start.getTime() - Date.now();
      if (remaining <= 0 && end && Date.now() < end.getTime()) { countdown.textContent = 'In progress'; return; }
      if (remaining <= 0) { countdown.textContent = 'Started'; return; }
      const minutes = Math.floor(remaining / 60000);
      const hours = Math.floor(minutes / 60);
      const days = Math.floor(hours / 24);
      if (days > 5) countdown.textContent = `in ${days} days`;
      else if (days >= 1) countdown.textContent = `in ${days} day${days === 1 ? '' : 's'} ${hours % 24} hour${hours % 24 === 1 ? '' : 's'}`;
      else if (hours >= 1) countdown.textContent = `in ${hours} hour${hours === 1 ? '' : 's'}`;
      else if (minutes >= 1) countdown.textContent = `in ${minutes} minute${minutes === 1 ? '' : 's'}`;
      else countdown.textContent = 'Starting now';
    };
    updateCountdown();
    window.setInterval(updateCountdown, 30000);
  </script>
</Layout>

<style>
  .event-row-link[hidden] { display: none !important; }
</style>



