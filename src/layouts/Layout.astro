---
import '../styles/global.css';
import '../styles/hero-diagram.css';
import '../styles/calendar-overrides.css';
import '../styles/seminar-series.css';
const { title = 'Miao Group', description = 'Miao Group academic calendar and seminar archive.', socialImage = 'social-preview.png' } = Astro.props;
const pathname = Astro.url.pathname;
const socialTitle = title === 'Home' ? 'Miao Group' : `${title} · Miao Group`;
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url.origin).href;
const socialImageUrl = new URL(`${import.meta.env.BASE_URL}${socialImage}`, Astro.site ?? Astro.url.origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Miao Group" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Miao Group boundary-to-bulk research graphic" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} · Miao Group</title>
    <script is:inline>
      window.MathJax = {
        tex: { inlineMath: [['\\(', '\\)'], ['$', '$']] },
        svg: { fontCache: 'global' }
      };
    </script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" onload="window.dispatchEvent(new Event('mathjax-ready'))"></script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={import.meta.env.BASE_URL} aria-label="Miao Group home">
          <span class="wordmark-mark" aria-hidden="true">∿</span>
          <span>Miao Group</span>
        </a>
        <nav aria-label="Main navigation">
          <a class:list={{ active: pathname.includes('/calendar') }} aria-current={pathname.includes('/calendar') ? 'page' : undefined} href={`${import.meta.env.BASE_URL}calendar/`}>Academic calendar</a>
          <a class:list={{ active: pathname.includes('/seminars') }} aria-current={pathname.includes('/seminars') ? 'page' : undefined} href={`${import.meta.env.BASE_URL}seminars/`}>Seminars</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-identity">
          <span class="footer-copyright">© <span data-current-year>{new Date().getFullYear()}</span> Miao Group</span>
          <span class="footer-institution"><span>School of Physics and Astronomy</span><span>Sun Yat-sen University</span></span>
        </div>
        <div class="footer-details">
          <span class="footer-topics">Holography · Strings · Quantum Gravity</span>
          <div class="footer-links">
            <a href="https://spa.sysu.edu.cn/en/teacher/2622" target="_blank" rel="noreferrer">Rong-Xin Miao · Profile (Chinese) ↗</a>
            <a href="https://orcid.org/0000-0003-1032-2313" target="_blank" rel="noreferrer" aria-label="Rong-Xin Miao on ORCID">ORCID ↗</a>
          </div>
          <span class="footer-timezone">UTC+8 · Asia/Shanghai</span>
        </div>
      </footer>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-current-year]').forEach((year) => { year.textContent = String(new Date().getFullYear()); });
      document.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-copy]');
        if (!button) return;
        const text = button.getAttribute('data-copy');
        if (!text) return;
        try {
          if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
          else throw new Error('Clipboard API unavailable');
        } catch {
          const helper = document.createElement('textarea');
          helper.value = text;
          helper.style.position = 'fixed';
          helper.style.opacity = '0';
          document.body.append(helper);
          helper.select();
          document.execCommand('copy');
          helper.remove();
        }
        if (button.matches('button')) {
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => { button.textContent = original; }, 1400);
        } else {
          button.classList.add('is-copied');
          button.title = 'Copied';
          window.setTimeout(() => { button.classList.remove('is-copied'); button.removeAttribute('title'); }, 1400);
        }
      });
      document.addEventListener('keydown', (event) => {
        if (!['Enter', ' '].includes(event.key)) return;
        const target = event.target.closest?.('[data-copy]');
        if (!target) return;
        event.preventDefault();
        target.click();
      });
      window.addEventListener('mathjax-ready', () => window.MathJax?.typesetPromise?.());
    </script>
  </body>
</html>
